# Copy to .env and adjust as needed. Never commit real credentials.

# Database (PostgreSQL started via docker compose)
DATABASE_URL=postgresql+asyncpg://flareguard:flareguard@localhost:5432/flareguard

# Google Web Risk Lookup API key. Leave empty/unset to disable the provider
# (the app still runs using the other detection methods).
GOOGLE_WEB_RISK_API_KEY=

# External provider / caching tuning
WEB_RISK_ENABLED=true
PROVIDER_TIMEOUT_SECONDS=5.0
RDAP_TIMEOUT_SECONDS=4.0
RDAP_CACHE_TTL_SECONDS=86400
ASSESSMENT_CACHE_TTL_SECONDS=1800

# Input limits
MAX_URL_LENGTH=2048
