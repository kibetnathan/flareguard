{
  "name": "Flare Guard",
  "description": "A Chrome extension to detect and block fraudulent website clones and redirect to the correct site",
  "version": "0.1",
  "manifest_version": 3,
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/main.html",
    "default_icon": "images/placeholder.jpg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js", "scripts/collector.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
